# Copy to .env and adjust. Never commit .env.

# Image used by compose files: ghcr.io/<owner>/<repo> by default, docker.io/<user>/<repo> if Docker Hub is configured
IMAGE=ghcr.io/dwightmulcahy/updock:latest

# Host port mapped to container port 8080
HOST_PORT=8080
TZ=UTC

# Updock
# Cron schedule (overrides UPDOCK_INTERVAL), e.g. 30 4 * * * or @daily; uses TZ above
UPDOCK_SCHEDULE=
# Random delay (0..this) added to scheduled runs so registries aren't hit on the exact minute
UPDOCK_JITTER=1m
# Only apply scheduled updates inside this daily window (outside it runs only check)
UPDOCK_WINDOW=
# seconds between scheduled runs; 0 = UI only
UPDOCK_INTERVAL=86400
# false = scheduled runs only check
UPDOCK_AUTO_UPDATE=true
# remove old image after update
UPDOCK_CLEANUP=true
# true = only containers labelled updock.enable=true
UPDOCK_LABEL_ENABLE=false
UPDOCK_RUN_ON_START=false
# Containers to leave alone by name, and images to only/never manage (comma-separated globs)
UPDOCK_EXCLUDE=
UPDOCK_INCLUDE_IMAGES=
UPDOCK_EXCLUDE_IMAGES=
# Several Updocks on one host: each manages only containers labelled updock.scope=<scope>
UPDOCK_SCOPE=
# Scheduled runs also update stopped containers (they stay stopped)
UPDOCK_INCLUDE_STOPPED=false
# Start stopped containers after their image is updated (label updock.revive overrides)
UPDOCK_REVIVE_STOPPED=false
UPDOCK_USER=admin
# empty = no auth (don't expose publicly)
# Secrets live in ./secrets (create them with scripts/init-secrets.sh, see secrets/README.md).
# Compose mounts them at /run/secrets/<name>; these settings point Updock at them.
# An empty file means "not set". (Plain UPDOCK_PASSWORD=... etc. still work but aren't recommended.)
UPDOCK_PASSWORD_FILE=/run/secrets/updock_password
# Bearer token for scripts/webhooks/Prometheus (/api/* and /metrics only)
UPDOCK_API_TOKEN_FILE=/run/secrets/updock_api_token
# Image storage guard: at/over max scheduled runs only check; warn = size or % of max
UPDOCK_DISK_MAX=
UPDOCK_DISK_WARN=
# Run updock.hook.* lifecycle hooks declared in container labels
UPDOCK_HOOKS=false
# Wait until new images are this old before scheduled runs apply them (0 = off), e.g. 24h, 3d12h
UPDOCK_COOLDOWN=0
# Check registry digests before pulling (false = always pull to check)
UPDOCK_DIGEST_CHECK=true
# Roll back if the new container isn't healthy in time / doesn't stay up
UPDOCK_HEALTH_TIMEOUT=120
UPDOCK_STARTUP_GRACE=10
# Public URL(s) when behind a reverse proxy that rewrites Host, comma-separated
UPDOCK_ALLOWED_ORIGINS=
# Serve /metrics without the UI login (for Prometheus without basic auth)
UPDOCK_METRICS_PUBLIC=false
# Logging: DEBUG|INFO|WARNING|ERROR, text|json, entries kept for the UI
UPDOCK_LOG_LEVEL=INFO
UPDOCK_LOG_FORMAT=text
UPDOCK_LOG_BUFFER=2000
# Email notifications (empty host or recipients = disabled)
UPDOCK_SMTP_HOST=
UPDOCK_SMTP_PORT=587
# starttls | ssl | none
UPDOCK_SMTP_SECURITY=starttls
UPDOCK_SMTP_USER=
UPDOCK_SMTP_PASSWORD_FILE=/run/secrets/updock_smtp_password
UPDOCK_SMTP_FROM=
# comma-separated recipients
UPDOCK_SMTP_TO=
# update,rollback,error,available,approval,disk,unhealthy,healthy,self-update,deploy,delete
UPDOCK_NOTIFY_EVENTS=update,rollback,error,available,approval,disk,unhealthy,healthy,self-update
UPDOCK_INSTANCE=
UPDOCK_URL=
# Only with compose.socket-proxy.yaml: allow exec (lifecycle hooks) / system (disk guard) through the proxy
SOCKET_PROXY_EXEC=0
SOCKET_PROXY_SYSTEM=0
# Health monitor between updates (0 = off), see docs/how-it-works.md "Health monitor"
UPDOCK_HEALTH_INTERVAL=0
UPDOCK_HEALTH_NOTIFY_AFTER=3
UPDOCK_HEALTH_RESTART_AFTER=0
UPDOCK_HEALTH_RESTART_ATTEMPTS=3
UPDOCK_HEALTH_HISTORY=7d
# Let the About tab update Updock itself
UPDOCK_ALLOW_SELF_UPDATE=false
# Serve /api/public/summary (counts only) without login, for dashboard widgets
UPDOCK_PUBLIC_API=false
# Private registries: plain-HTTP hosts, extra CA bundle for HTTPS
UPDOCK_INSECURE_REGISTRIES=
UPDOCK_REGISTRY_CA=
